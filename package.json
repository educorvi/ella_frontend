{
  "name": "ella_frontend",
  "version": "2025.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/",
    "generate-api-client": "openapi-ts --no-log-file -i https://ella.uv-kooperation.de/openapi.json -o src/api-client -c @hey-api/client-axios"
  },
  "dependencies": {
    "@hey-api/client-axios": "^0.7.0",
    "bootstrap": "^5.3.5",
    "bootstrap-vue-next": "^0.28.5",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.66.3",
    "@tsconfig/node22": "^22.0.1",
    "@types/bootstrap": "^5",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.86.3",
    "typescript": "~5.8.0",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.8"
  },
  "packageManager": "yarn@4.9.0"
}
